{
  "name": "winstore-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Winstore Desktop — an Electron shell that bundles PostgreSQL and runs the EXISTING Winstore backend + built frontend locally. Adds nothing to and changes nothing in ../backend or ../frontend; it consumes them as artifacts.",
  "main": "main.js",
  "author": "Winstore",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "make-icon": "node scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.winstore.desktop",
    "productName": "Winstore",
    "asar": true,
    "asarUnpack": [
      "node_modules/embedded-postgres/**",
      "node_modules/@embedded-postgres/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.env",
          "!tests/**",
          "!**/*.test.js",
          "!**/*.smoke.js"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "target": "nsis",
      "publisherName": "Winstore"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": { "target": "AppImage", "category": "Office" }
  }
}
