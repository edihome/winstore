PORT=5000
# Optional interface binding. Set 127.0.0.1 for a single PC or reverse proxy;
# leave blank to accept LAN connections. Desktop always forces 127.0.0.1.
HOST=
# development | production | test. Production enforces a strong JWT_SECRET,
# restricts CORS to FRONTEND_URL (localhost/LAN always allowed), etc.
NODE_ENV=development

# Local Postgres (matches the docker run command in the README)
DATABASE_URL=postgresql://winstore:winstore@localhost:5432/winstore_db

# REQUIRED to be strong (>=32 random chars) in production — the app refuses
# to boot otherwise. Generate one offline with: npm run generate-secret
JWT_SECRET=replace-this-with-a-long-random-secret

# Public browser origin(s) allowed to call the API in production, comma-
# separated (e.g. https://app.winstore.ng). Leave blank for an offline/LAN
# install — localhost and private LAN addresses are always allowed.
FRONTEND_URL=

# Set only when the app runs behind a reverse proxy / PaaS load balancer:
# "true" (trust one hop), a number (N hops), or an IP/subnet. Leave blank for
# a direct local/LAN install so client IPs can't be spoofed via headers.
TRUST_PROXY=

# Standalone/cloud defaults: no synchronization. To serve as head office,
# enable sync and keep NODE_KIND=hub. Branch installs use NODE_KIND=branch
# and enrollment; they cannot register a separate local business.
SYNC_ENABLED=false
SYNC_NODE_KIND=hub
# Public API origin embedded in desktop setup codes (no /api/v1 suffix).
# Set this on head office, especially behind a proxy or separate frontend.
SYNC_PUBLIC_URL=
SYNC_HUB_URL=
SYNC_HUB_TOKEN=
