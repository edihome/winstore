{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "test:setup": "node scripts/setup-test-db.js",
    "test:reset": "node scripts/setup-test-db.js reset",
    "migrate:create": "node-pg-migrate create -m database/migrations",
    "migrate": "node-pg-migrate up -m database/migrations",
    "rollback": "node-pg-migrate down -m database/migrations",
    "create-developer": "node scripts/create-developer.js",
    "reset-password": "node scripts/reset-password.js",
    "generate-secret": "node scripts/generate-secret.js",
    "backup": "node scripts/backup-db.js",
    "build:web": "npm --prefix ../frontend install --include=dev && npm --prefix ../frontend run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.22.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
